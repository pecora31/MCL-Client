{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MCL Client",
  "version": "0.9.0",
  "identifier": "com.pecora.mclclient",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MCL Client - Minecraft Launcher",
        "width": 1600,
        "height": 900,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0f10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pecora31/MCL-Client/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MDBCRTcwMzkxRjQ4OEYKUldTUFNCODVjTDRBU1Z2ZDdXKzh2ckNxYWdhb3o2ayt4WldJcXRFK1JkUXNaYXFPUXdQVG1rTnQK"
    }
  }
}
